NEXT_PUBLIC_APP_URL=https://your-domain.com

# Required for real data (set on Railway; on Vercel too if you do not proxy API to Railway)
MONGODB_URI=

# Optional: database name (default: wiper)
# MONGODB_DB=wiper

# Vercel: forward /api/* to Railway (public HTTPS URL of your Railway service)
# API_UPSTREAM=https://your-service.up.railway.app

# Only for debugging: never set in real production
# MONGODB_FALLBACK=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_FROM=hello@your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
