# Copy to .env.local for local dev. In Vercel / Railway: set the same keys in the dashboard.

# Public site URL (production: https://your-app.vercel.app or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override default https://www.instagram.com/wiperqa/
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/wiperqa/

# MongoDB — required in production (Vercel and/or Railway). Atlas SRV string is fine.
MONGODB_URI=

# Optional: database name (default: wiper)
# MONGODB_DB=wiper

# Vercel only: proxy browser /api/* calls to the Railway-hosted app (no CORS issues).
# Example: https://wiper-production.up.railway.app  (no trailing slash)
# Leave unset on Railway and for local dev so this process serves /api itself.
# API_UPSTREAM=

# Local dev only: allow in-memory demo data if Mongo is down (default true in dev).
# Production defaults to false — failed Mongo calls return 503 instead of fake data.
# MONGODB_FALLBACK=true

# Contact form: if Mongo is misconfigured or unreachable, submissions are still accepted
# and held in server memory (and optional ADMIN_WEBHOOK_URL). Set MONGODB_URI for durable storage.
# ADMIN_WEBHOOK_URL=https://hooks.slack.com/...  (POST JSON on each inquiry)

# Stripe (optional: checkout API falls back to demo mode when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional, for future transactional email)
EMAIL_FROM=hello@wiper.qa
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
