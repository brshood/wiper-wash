# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables (Production / Preview / Development).

# Public site URL (use your production domain on Vercel, e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (required for /api/orders, /api/subscriptions, /api/assignments at runtime)
MONGODB_URI=

# Stripe (optional: checkout API falls back to demo mode when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional, for future transactional email)
EMAIL_FROM=hello@wiper.qa
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
